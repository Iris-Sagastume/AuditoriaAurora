@model SistemaAuditoria.Models.Recomendacion

@using (Html.BeginForm("GuardarRecomendacion", "Auditoria", FormMethod.Post))
{
    <div>
        <label>Aspecto Evaluado:</label>
        @Html.TextBoxFor(m => m.AspectoEvaluado, new { @class = "form-control" })
    </div>
    <div>
        <label>Observaciones:</label>
        @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control" })
    </div>
    <div>
        <label>Recomendaciones:</label>
        @Html.TextAreaFor(m => m.RecomendacionesTexto, new { @class = "form-control" })
    </div>
    <div>
        <label>Riesgos:</label>
        @Html.TextAreaFor(m => m.Riesgos, new { @class = "form-control" })
    </div>
    <div>
        <label>Fortalezas:</label>
        @Html.TextAreaFor(m => m.Fortalezas, new { @class = "form-control" })
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
}
